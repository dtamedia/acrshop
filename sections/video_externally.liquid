<section class="section_video">
  <div class="padding-global-13 padding-section-small">
    <div class="container-large-7">
      {% if section.settings.video != blank %}
        <div class="video_wrapper">
          {% if section.settings.video.type == 'youtube' %}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.video.id }}?rel=0&modestbranding=1&playsinline=1"
              title="Video"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen>
            </iframe>
          {% elsif section.settings.video.type == 'vimeo' %}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.video.id }}?title=0&byline=0&portrait=0"
              title="Video"
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen>
            </iframe>
          {% endif %}
        </div>
      {% else %}
        <div style="padding: 16px; border: 1px dashed #ccc;">
          Bitte eine YouTube- oder Vimeo-URL in den Section-Settings eintragen.
        </div>
      {% endif %}
    </div>
  </div>

  <style>
    .video_wrapper { position: relative; width: 100%; aspect-ratio: 16 / 9; }
    .video_wrapper iframe { position: absolute; inset: 0; width: 100%; height: 100%; }
  </style>
</section>

{% schema %}
{
  "name": "Video (Externally)",
  "tag": "section",
  "class": "section_video",
  "settings": [
    {
      "type": "video_url",
      "id": "video",
      "label": "Video",
      "accept": ["youtube", "vimeo"]
    }
  ],
  "presets": [
    {
      "name": "Video (Externally)",
      "category": "Liquify"
    }
  ]
}
{% endschema %}
